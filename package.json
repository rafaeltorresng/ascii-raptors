{
  "name": "ascii-raptors",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Articulated birds of prey rendered as real ASCII on Canvas, with a five-bird sky and three original anatomical models.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    }
  },
  "files": [
    "dist/lib",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "check": "npm run typecheck",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build:demo": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build": "npm run check && npm run build:demo && npm run build:lib",
    "preview": "vite preview --host 127.0.0.1 --port 5180 --strictPort",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run format:check && npm test && npm run build",
    "pack:check": "npm pack --dry-run",
    "check:demo": "node --experimental-strip-types scripts/check-demo.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.5"
  },
  "author": "Rafael Torres",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaeltorresng/ascii-raptors.git"
  },
  "bugs": {
    "url": "https://github.com/rafaeltorresng/ascii-raptors/issues"
  }
}
